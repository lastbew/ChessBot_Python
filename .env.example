# ------------------------------------------------------------------
# Copy this file to ".env" and fill in your real values.
#   PowerShell:  Copy-Item .env.example .env
# Then edit .env and paste your token after the "=" sign.
# ------------------------------------------------------------------

# Your Lichess personal access token (needs the "board:play" scope).
# Create one at: https://lichess.org/account/oauth/token
LICHESS_TOKEN=

# Who should the bot challenge? Put the opponent's Lichess username.
# Leave blank to just RESUME any game you already have running.
CHALLENGE_USERNAME=

# Clock: minutes on each side, and seconds added per move.
CLOCK_MINUTES=3
CLOCK_INCREMENT=2

# The bot only prints the move it WOULD play, without sending it.
# Set to 1 for a safe practice run, then 0 to actually play.
DRY_RUN=1

# How long Stockfish may think per move, in milliseconds.
MOVE_TIME_MS=800

# Show the "Bot Vision" pygame window while playing (1 = on, 0 = off).
SHOW_VISION=1
